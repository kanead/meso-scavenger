<Group hide-input="false" labelreference="L574" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Define model equations:
V_dyn:=-mu_V*V + g_V*V*(e_V*C)/(1+e_V*C*(h_V));
J_dyn:=rJ*J*(1-J/KJ)+g_J*J*(e_J*(C+N))/(1+h_J*e_J*(C+N));
H_dyn:=rH*H*(1-H/KH)+g_H*H*(e_H*(C+N))/(1+h_H*e_H*(C+N));
L_dyn:=rL*L*(1-L/KL)+g_L*L*(e_L*(C+N))/(1+h_L*e_L*(C+N));
C_dyn:=C_in*(1-n_f) - mu_C*C -V*(e_V*C)/(1+e_V*C*(h_V)) -J*(e_J*C)/(1+h_J*e_J*(C+N)) -H*(e_H*C)/(1+h_H*e_H*(C+N)) -L*(e_L*C)/(1+h_L*e_L*(C+N));
N_dyn:=p*n_f - mu_C*N -J*(e_J*N)/(1+h_J*e_J*(C+N)) -H*(e_H*N)/(1+h_H*e_H*(C+N)) -L*(e_L*N)/(1+h_L*e_L*(C+N));</Text-field>
</Input>
</Group>
